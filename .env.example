# Скопируй в .env и заполни своими значениями
# Токен для REST API (Bearer-авторизация, один пользователь)
FLIPPER_API_KEY=change-me

# LLM (бесплатный облачный API, OpenAI-совместимый)
# Groq: https://console.groq.com — без карты. Просто вставь ключ.
GROQ_API_KEY=
# Альтернатива: любой OpenAI-совместимый провайдер
FLIPPER_LLM_API_KEY=
FLIPPER_LLM_BASE_URL=

# FCM (Phase B)
FLIPPER_FCM_SERVICE_ACCOUNT=

# Telegram-уведомления (проще FCM, мобильное приложение не нужно)
# Токен берётся у @BotFather, chat_id — у @userinfobot (или из getUpdates)
FLIPPER_TELEGRAM_BOT_TOKEN=
FLIPPER_TELEGRAM_CHAT_ID=

# Если Kleinanzeigen заротирует центы (красные 401/403), укажи свежие
KLEINANZEIGEN_BASIC_USER=
KLEINANZEIGEN_BASIC_PW=